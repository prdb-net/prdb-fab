    },
    "/api/onboarding/take": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnboardingStepRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/onboarding/skip": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnboardingStepRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/connections": {
      "get": {
        "tags": [
          "Connections"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionsState"
                }
              }
            }
          }
        }
      }
    },
    "/api/connections/prdb": {
      "post": {
        "tags": [
          "Connections"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrdbConnectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrdbConnectionVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/connections/sabnzbd/categories": {
      "post": {
        "tags": [
          "Connections"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SabnzbdCategoriesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SabnzbdCategoriesVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/connections/sabnzbd": {
      "post": {
        "tags": [
          "Connections"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SabnzbdConnectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SabnzbdConnectionVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/connections/indexers": {
      "get": {
        "tags": [
          "Connections"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConfiguredIndexer"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Connections"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexerConnectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexerConnectionVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/connections/indexers/{id}": {
      "post": {
        "tags": [
          "Connections"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexerConnectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexerConnectionVerdict"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/connections/library-root": {
      "post": {
        "tags": [
          "Connections"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibraryRootRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryRootVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/skeleton/items": {
      "get": {
        "tags": [
          "Skeleton"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Skeleton"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddItemVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/skeleton/sweep/run-now": {
      "post": {
        "tags": [
          "Skeleton"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunNowVerdict"
                }
              }
            }
          }
        }
      }
    },
    "/api/skeleton/runs": {
      "get": {
        "tags": [
          "Skeleton"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecordedRun"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessState": {
        "required": [
          "passwordSet",
          "signedIn",
          "nextStep"
        ],
        "type": "object",
        "properties": {
          "passwordSet": {
            "type": "boolean"
          },
          "signedIn": {
            "type": "boolean"
          },
          "nextStep": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OnboardingStep"
              }
            ]
          }
        }
      },
      "AddItemRequest": {
        "required": [
          "label"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AddItemVerdict": {
        "required": [
          "added",
          "refusal"
        ],
        "type": "object",
        "properties": {
          "added": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SkeletonItem"
              }
            ]
          },
          "refusal": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChangePasswordOutcome": {
        "enum": [
          "Changed",
          "WrongPassword",
          "Refused"
        ]
      },
      "ChangePasswordRequest": {
        "required": [
          "current",
          "next"
        ],
        "type": "object",
        "properties": {
          "current": {
            "type": [
              "null",
              "string"
            ]
          },
          "next": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChangePasswordVerdict": {
        "required": [
          "outcome",
          "refusal",
          "sessionsEnded"
        ],
        "type": "object",
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/ChangePasswordOutcome"
          },
          "refusal": {
            "type": [
              "null",
              "string"
            ]
          },
          "sessionsEnded": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ConfiguredIndexer": {
        "required": [
          "id",
          "name",
          "url",
          "categories",
          "lastVerdict",
          "lastCheckedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "categories": {
            "type": "string"
          },
          "lastVerdict": {
            "$ref": "#/components/schemas/IndexerConnectionOutcome"
          },
          "lastCheckedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConnectionsState": {
        "required": [
          "prdbConfigured",
          "sabnzbdConfigured",
          "sabnzbdSkipped",
          "sabnzbdUrl",
          "sabnzbdCategory",
          "completedRoot",
          "downloadDirectory",
          "indexerCount",
          "indexersSkipped",
          "libraryRoot"
        ],
        "type": "object",
        "properties": {
          "prdbConfigured": {
            "type": "boolean"
          },
          "sabnzbdConfigured": {
            "type": "boolean"
          },
          "sabnzbdSkipped": {
            "type": "boolean"
          },
          "sabnzbdUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "sabnzbdCategory": {
            "type": [
              "null",
              "string"
            ]
          },
          "completedRoot": {
            "type": [
              "null",
              "string"
            ]
          },
          "downloadDirectory": {
            "type": [
              "null",
              "string"
            ]
          },
          "indexerCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "indexersSkipped": {
            "type": "boolean"
          },
          "libraryRoot": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "IndexerConnectionOutcome": {
        "enum": [
          "Saved",
          "WrongKey",
          "LimitReached",
          "NotAnIndexer",
          "Refused",
          "NotRightNow",
          "AlreadyAdded",
          "NoCategories"
        ]
      },
      "IndexerConnectionRequest": {
        "required": [
          "name",
          "url",
          "apiKey"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "IndexerConnectionVerdict": {
        "required": [
          "outcome",
          "detail",
          "categories"
        ],
        "type": "object",
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/IndexerConnectionOutcome"
          },
          "detail": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ItemPage": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkeletonItem"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "LibraryRootOutcome": {
        "enum": [
          "Saved",
          "SavedWithWarning",
          "NotAbsolute",
          "Missing",
          "NotWritable",
          "InsideDownloadDirectory",
          "ContainsDownloadDirectory"
        ]
      },
      "LibraryRootRequest": {
        "required": [
          "path"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LibraryRootVerdict": {
        "required": [
          "outcome",
          "detail"
        ],
        "type": "object",
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/LibraryRootOutcome"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "OnboardingOutcome": {
        "enum": [
          "Taken",
          "Skipped",
          "NotTheCurrentStep",
          "NotConfigured",
          "NotSkippable"
        ]
      },
      "OnboardingStep": {
        "enum": [
          "Password",
          "PrdbKey",
          "Sabnzbd",
          "Indexers",
          "LibraryRoot",
          "Complete",
          null
        ]
      },
      "OnboardingStepRequest": {
        "required": [
          "step"
        ],
        "type": "object",
        "properties": {
          "step": {
            "$ref": "#/components/schemas/OnboardingStep"
          }
        }
      },
      "OnboardingVerdict": {
        "required": [
          "outcome",
          "detail",
          "nextStep"
        ],
        "type": "object",
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/OnboardingOutcome"
          },
          "detail": {
            "type": "string"
          },
          "nextStep": {
            "$ref": "#/components/schemas/OnboardingStep"
          }
        }
      },
      "PrdbConnectionOutcome": {
        "enum": [
          "Saved",
          "WrongKey",
          "NoApiAccess",
          "QuotaSpent",
          "NotRightNow",
          "AnotherAccount"
        ]
      },
      "PrdbConnectionRequest": {
        "required": [
          "apiKey",
          "confirmAnotherAccount"
        ],
        "type": "object",
        "properties": {
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "confirmAnotherAccount": {
            "type": "boolean"
          }
        }
      },
      "PrdbConnectionVerdict": {
        "required": [
          "outcome",
          "detail",
          "retryAfterSeconds"
        ],
        "type": "object",
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/PrdbConnectionOutcome"
          },
          "detail": {
            "type": "string"
          },
          "retryAfterSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RecordedRun": {
        "required": [
          "id",
          "routineName",
          "startedAt",
          "outcome",
          "itemsHandled",
          "reason"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "routineName": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "$ref": "#/components/schemas/RunOutcome"
          },
          "itemsHandled": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RunNowVerdict": {
        "required": [
          "accepted",
          "detail"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "RunOutcome": {
        "enum": [
          "Succeeded",
          "Failed",
          "Interrupted"
        ]
      },
      "SabnzbdCategoriesRequest": {
        "required": [
          "url",
          "apiKey"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SabnzbdCategoriesVerdict": {
        "required": [
          "outcome",
          "detail",
          "categories"
        ],
        "type": "object",
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/SabnzbdConnectionOutcome"
          },
          "detail": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SabnzbdCategory"
            }
          }
        }
      },
      "SabnzbdCategory": {
        "required": [
          "name",
          "completedRoot"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "completedRoot": {
            "type": "string"
          }
        }
      },
      "SabnzbdConnectionOutcome": {
        "enum": [
          "Saved",
          "WrongKey",
          "AccessDenied",
          "NotSabnzbd",
          "NotRightNow",
          "UnknownCategory",
          "DownloadDirectoryMissing",
          "DownloadDirectoryUnreadable"
        ]
      },
      "SabnzbdConnectionRequest": {
        "required": [
          "url",
          "apiKey",
          "category",
          "downloadDirectory"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "type": [
              "null",
              "string"
            ]
