{
  "openapi": "3.1.1",
  "info": {
    "title": "prdb-fab",
    "description": "The API the browser side of prdb-fab talks to. Generated from the code at build time and committed: change an endpoint, not this file.",
    "version": "v1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/access/state": {
