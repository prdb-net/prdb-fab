<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- ADR 0040: the document the frontend's types are generated from. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Writes that document at build time, without the application running. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" />
    <!--
      Microsoft.AspNetCore.OpenApi 10.0.10 still pulls Microsoft.OpenApi 2.0.0,
      which carries GHSA-v5pm-xwqc-g5wc. Referencing a patched 2.x directly
      overrides it; the pin goes when ASP.NET Core ships one that no longer
      needs it.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!--
      ADR 0039 pins this deliberately: EF Core 10.0.10 still pulls SQLitePCLRaw
      2.1.11, whose bundled SQLite carries GHSA-2m69-gcr7-jv3q. Referencing the
      3.x bundle directly overrides that.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!--
      ADR 0043: console and a rolling file, both from this one reference. Apache-2.0
      here and in everything it brings — which is half of why it is here at all.
    -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!--
    ADR 0042: xUnit v3, the test SDK, the host testing package and a controllable
    clock. Deliberately no mocking and no assertion package — ADR 0035 forbids
    doubling out the wiring a test exists to check, and `Assert.Equivalent` in
    xunit itself covers what an assertion library is usually taken for.
  -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

</Project>
